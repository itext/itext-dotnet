				<dependency id="SkiaSharp" version="3.119.4" />
				<dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="3.119.4" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="bin\Release\net461\itext.webp-image-support.dll" target="lib\net461" />
		<file src="bin\Release\net461\itext.webp-image-support.xml" target="lib\net461" />
